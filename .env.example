# Sonar Docs — environment configuration (copy to .env and fill in)

# SQLite database location (Prisma)
DATABASE_URL=file:./db/custom.db

# ── AI engines ────────────────────────────────────────────────────────────
# Gemini (Google AI Studio key). When set, OCR + document AI run on Gemini
# with per-subject engines:
#   • Sindhi + custom RTL subjects → gemini-3.5-flash · medium thinking · code execution
#   • Urdu / English / Mathematics + custom LTR → gemini-3.5-flash-lite · high thinking · code execution
# When empty, the Z.ai SDK is used as a fallback engine for everything.
GEMINI_API_KEY=
# GOOGLE_API_KEY=          # alternative name for the Gemini key

# Optional model overrides (defaults shown)
# GEMINI_MODEL_HARD=gemini-3.5-flash
# GEMINI_MODEL_DEFAULT=gemini-3.5-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Z.ai SDK (fallback engine — used when Gemini is not configured)
# ZAI_BASE_URL=
# ZAI_API_KEY=
